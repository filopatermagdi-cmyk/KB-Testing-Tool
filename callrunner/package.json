{
  "name": "callrunner",
  "version": "1.0.0",
  "private": true,
  "description": "E2E smoke test: places a call through the deployed frontend and verifies zilla replies to each sentence.",
  "type": "commonjs",
  "scripts": {
    "prep": "tsx prep.ts",
    "tts": "tsx tts.ts",
    "test": "tsx e2e.ts",
    "test:interrupt": "tsx e2e.ts --interrupt",
    "selftest": "tsx e2e.ts --selftest",
    "interruption": "python classify_interruptions.py --handoff tmp/last-call.json --latest --no-web-filter --fail-on-interruption --wait-recording-seconds 20 -d tmp/recordings",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
