# CallRunner (E2E through the frontend) — copy to .env and fill in. In CI, inject
# these names from your secret store instead of committing .env.

# --- required ---
APP_URL=https://ziila-stg.intella.me          # deployed frontend under test
ZILLA_EMAIL="splonprem@ruutukf.com"
ZILLA_PASSWORD=

# --- backend API: required for agent lookup, conversation lookup, and persisted
#     transcript validation. Auto-read from ../zilla-frontend/.env
#     (VITE_API_BASE_URL) if present; set here in CI where there is no frontend
#     working tree or when you want an explicit target. ---
VITE_API_BASE_URL=
FRONTEND_ENV_PATH=

# --- agent selection: leave ZILLA_AGENT_ID empty to use the first agent in the
#     account (fetched via the backend API base) ---
ZILLA_AGENT_ID=

# --- optional ---
APP_LOCALE=en
# Which caller clips to run. Default: the committed assets/ (works on a fresh
# clone / CI with no setup). For the TTS workflow, generate clips with
# `npm run tts` (writes the gitignored assets-tts/) and set this — then
# `npm test` uses them with no extra args.
# ASSETS_DIR=assets-tts
NAV_TIMEOUT_MS=60000       # per navigation / element wait (30s can time out against slow dev servers under load)
CALL_START_MS=60000        # wait for the call to connect after clicking start (dev servers are slow under 10-way concurrency)
TURN_TIMEOUT_MS=60000      # wait for zilla's reply after each sentence (under load a real reply may exceed 40s)
OPENING_REPLY_WAIT_MS=10000 # opening turn: wait this long for a reply to our first line before moving on (she greets first, so silence here is OK, never fails)
SETTLE_MS=1500             # zilla-quiet window before each clip (avoids false replies)
RETRIES=0                  # extra full-call attempts if one fails (0 = each session runs exactly once, no retry)
ATTEMPT_TIMEOUT_MS=1200000  # hard wall-clock per attempt (20 min: 10 concurrent calls + 60s-per-clip no-reply waits)
ARTIFACT_WAIT_MS=900000  # wait for backend transcript + recording_url persistence after hangup; probe showed STT transcript took ~8-15 min to persist under 10 concurrent calls
ARTIFACT_POLL_MS=3000      # poll cadence for persisted call artifact lookup
TRANSCRIPT_MIN_TURNS=2     # minimum non-empty persisted transcript turns; also requires customer + agent
CALL_MATCH_SKEW_MS=60000   # clock-skew allowance when matching latest conversation to this run
VIDEO_ON_FAILURE=1         # keep Playwright video under tmp/videos only for failed attempts; set 0 to disable
VIDEO_ALWAYS=0             # set 1 to ALSO keep videos of passing runs (debug/demo — recorded every run anyway)
REPLY_LATENCY_WARN_MS=6000 # a reply slower than this prints a warning (LATENCY_RESULT=WARN); non-blocking
REPLY_LATENCY_MAX_MS=0     # >0: FAIL the run if any reply exceeds this (LATENCY_RESULT=FAIL); 0 = disabled
INTERRUPT=0                # set 1 (or pass --interrupt) to deliberately barge in over zilla and test she yields
INTERRUPT_DELAY_MS=2500    # barge in this long after the prompt clip (≈ zilla's reply latency, to overlap her speech)
TMP_KEEP_RUNS=10           # keep this many recent summaries + videos in tmp/; older ones auto-pruned each run
TRANSCRIPT_MATCH_MIN=0.95  # live-vs-backend transcript similarity for PASS (0-1); high on purpose — same source, only segmentation differs. non-blocking
TRANSCRIPT_MATCH_WARN=0.5  # below MIN but >= this = WARN (else FAIL) for the transcript-match signal
ROUTE_PROBE_MS=8000        # per-candidate wait for the call Start button when probing call-page routes
POLL_MS=200                # DOM poll interval while waiting for replies / idle / barge-in
CONVERSATION_PAGE_SIZE=50  # page size when listing recent conversations to find this run's call; keep > concurrent calls or a busy agent's own call drops off page 0
REPLY_MIN_LATENCY_MS=800   # ignore "replies" faster than this ms — stale/streaming bleed from the prior turn, not a real answer

# --- app coupling: override ONLY if the frontend routing or markup changes.
#     Routes: {locale}=locale segment (with leading slash, or empty), {agentId}=agent.
#     CALL_PATHS is a comma-separated fallback list, tried in order. ---
LOGIN_PATH={locale}/auth/login
CALL_PATHS={locale}/agents/{agentId}/call,{locale}/protected/agents/{agentId}/call
SEL_EMAIL=input[type="email"]
SEL_PASSWORD=input[type="password"]
SEL_SUBMIT=button[type="submit"]
SEL_START=button:has(img[alt="Mic icon button"])
SEL_END=End
SEL_ZILLA_MSG=img[src*="ziila-logo-avatar.png"]
# Marker for the pre-call intro screen (InitiateCall), if the build gates the
# call behind one — the runner clicks through it to reach the live call. Its
# Start button is identical to the real one, so detection keys off this
# illustration instead. Absent on builds without the intro screen.
SEL_CALL_INTRO=img[alt="soundwaves"]

# --- tts.ts (dev-time clip generation) ---
# EDGE_VOICE=ar-EG-SalmaNeural   # edge-tts voice (unset = offline Windows SAPI)
# SAPI_VOICE=                    # SAPI voice name override
# SLUG_MAX=40                    # max generated-clip filename slug length
# SILENCE_DB=-40dB               # silence gate for trimming clip lead/tail; lower for a quiet voice
