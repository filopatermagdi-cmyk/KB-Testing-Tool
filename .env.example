# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider for question generation ---
# "gemini" = Google AI Studio, FREE tier, no credit card (recommended to start)
# "openai" = paid, same key evaluate.py already uses
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini — get one free at https://aistudio.google.com
GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- how many KB chunks to generate from ---
# a number (e.g. 5) for a small first look, or "all" to cover the whole KB.
# Each selected chunk produces one question PER enabled language below.
SAMPLE_SIZE=20
GENERATE_ENGLISH=true
GENERATE_ARABIC=true

# --- safe-for-large-KB behavior (only matters when SAMPLE_SIZE=all, or any
#     run large enough to risk hitting a rate limit or getting interrupted) ---
# Skip chunk+language combos already in data/questions.json instead of
# regenerating them — lets you re-run after a crash/interruption/rate-limit
# and continue where you left off, or top up after enabling a new language.
RESUME=true
# Pause this many ms between LLM calls. Gemini's free tier is roughly
# 15 requests/minute for Flash — set this to ~4000 to stay comfortably
# under that on a big KB. Leave at 0 for a small SAMPLE_SIZE.
REQUEST_DELAY_MS=0
# How many times to retry a single call after a 429 (rate limited) response,
# with exponential backoff, before giving up.
MAX_RETRIES=5

# --- Phase 3: Session Builder config ---

# How many questions (turns) go into a single call/session
MESSAGES_PER_SESSION=3

# How many sessions to build per language
TOTAL_SESSIONS_AR=3
TOTAL_SESSIONS_EN=2

# Seed for reproducible random session composition/ordering.
# Same seed + same questions.json = identical sessions.json every time.
RANDOM_SEED=42

# If true, a question can appear in more than one session once the pool of
# unique questions for that language runs out. If false (default), the
# builder stops early rather than emit a session shorter than
# MESSAGES_PER_SESSION.
ALLOW_REPEAT_QUESTIONS=false

# Agent ids from your Zilla account. Find them by logging into the Zilla app
# (https://ziila-stg.intella.me), opening each agent's page, and copying the id
# from the URL: .../agents/<AGENT_ID>. The AR and EN agents are two separate
# agents — paste each in its matching slot. Sessions will still build without
# these (agent_id will just be null); Phase 4A (Runner) is what uses them.
ZILLA_AGENT_ID_AR=PASTE_AR_AGENT_ID_HERE
ZILLA_AGENT_ID_EN=PASTE_EN_AGENT_ID_HERE

# --- Phase 4B: Session Runner (direct WebSocket) ---
# Per ZIILA_WEBSOCKET_INTEGRATION.pdf: WS /audio/{token}. Keep the token as the
# last path segment here — the handshake re-uses it, so there is one source of
# truth instead of two values that can drift apart.
WS_URL=ws://HOST:PORT/audio/YOUR_TOKEN

# text (default) = send {"text": question} directly - no audio/TTS needed,
# exercises the agent + KB retrieval + LLM layer without STT/TTS noise.
# audio = stream wav/Qxxx.wav as PCM16 mono 16kHz frames (not built yet).
WS_MODE=text

# Ziila streams the answer sentence-by-sentence with no explicit "done" signal,
# so a turn's answer is considered complete after this many ms with no new frame.
WS_SETTLE_MS=1800
# Hard cap waiting for the first sign of a reply before giving up on a turn.
WS_TURN_TIMEOUT_MS=20000
# Pause between turns in the same session (let Ziila fully settle first).
WS_INTER_TURN_MS=400
# Final-answer confirm window: a turn's answer is NOT final until this many ms
# pass with zero frames. Any late sentence keeps the current turn open, so a
# slow tail of answer N can never bleed into question N+1.
WS_CONFIRM_MS=500
# Max ms to wait for one WS handshake to reach OPEN before counting the attempt
# as failed (the proxy can reject/drop simultaneous connects).
WS_CONNECT_TIMEOUT_MS=10000
# Max connect attempts per session. Each failed attempt opens a fresh socket,
# so transient refusals don't mark a whole session "no reply".
WS_CONNECT_ATTEMPTS=3
# Random stagger (ms) before the first connect of a session and between
# retries — spreads simultaneous batch opens so the proxy isn't hit by a burst.
WS_CONNECT_STAGGER_MS=2500

# --- Phase 4A: Session Runner (UI) ---

# CallRunner is vendored in ./callrunner (source copied from the reference repo),
# so nothing else is needed. CALLRUNNER_DIR is only an optional override if you
# want to use a different copy.
# CALLRUNNER_DIR=

# Zilla connection. The runner forwards these to CallRunner, so you don't need
# to configure CallRunner's own .env (it's used as fallback only if blank here).
APP_URL=https://ziila-stg.intella.me
ZILLA_EMAIL=YOUR_ZILLA_LOGIN_EMAIL
ZILLA_PASSWORD=YOUR_ZILLA_LOGIN_PASSWORD
VITE_API_BASE_URL=https://ziila-stg-api.intella.me/api

# Where per-session run outputs are written (default: data/runs)
# RUNS_DIR=data/runs

# --- Phase 4A scheduling (how many calls run at once) ---
#
# CONCURRENCY = total calls in flight when the per-language budgets below are
# NOT set. Example: CONCURRENCY=10 -> 10 calls at once, mixing languages freely.
#
# OR, to control the AR/EN mix exactly, set CONCURRENT_AR + CONCURRENT_EN.
# The runner then keeps AT MOST that many AR and EN calls running at the same
# time; when one finishes it immediately starts the next of the same language.
# Example: 10 calls at once = 4 ar + 6 en, waves until all done.
CONCURRENCY=10
CONCURRENT_AR=4
CONCURRENT_EN=6

# RESHUFFLE=true -> re-randomize the question order INSIDE each session on every
# run (no rebuild needed). RESHUFFLE=false (default) -> play each session exactly
# as built by the seeded session builder.
RESHUFFLE=true

# SHUFFLE_SESSIONS=true -> randomize which sessions run + in what order each run,
# so repeated runs exercise DIFFERENT sessions (not always 1,2,3).
# SESSIONS_PER_RUN -> run only this many sessions this run (random pick when
# SHUFFLE_SESSIONS=true). Leave 0/empty = run ALL sessions.
SHUFFLE_SESSIONS=true
SESSIONS_PER_RUN=0